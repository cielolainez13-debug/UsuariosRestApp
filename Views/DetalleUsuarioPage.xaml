<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:UsuariosRestApp.ViewModels"
             x:Class="UsuariosRestApp.Views.DetalleUsuarioPage"
             x:DataType="vm:DetalleUsuarioViewModel"
             Title="Detalle del Usuario">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#E91E63" />

            <Border StrokeShape="RoundRectangle 12"
                    Padding="20"
                    BackgroundColor="#F9F9F9"
                    Stroke="#DDDDDD">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding UsuarioDetalle.Id, StringFormat='ID: #{0}'}"
                           FontSize="14"
                           TextColor="#E91E63"
                           FontAttributes="Bold" />

                    <Label Text="{Binding UsuarioDetalle.Name}"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <BoxView HeightRequest="1" Color="#E0E0E0" />

                    <Label Text="{Binding UsuarioDetalle.Email, StringFormat='Correo: {0}'}" FontSize="16" />
                    <Label Text="{Binding UsuarioDetalle.Phone, StringFormat='Teléfono: {0}'}" FontSize="16" />
                    <Label Text="{Binding UsuarioDetalle.Website, StringFormat='Sitio Web: {0}'}" FontSize="16" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Eliminar usuario"
                    Command="{Binding EliminarUsuarioCommand}"
                    BackgroundColor="#D32F2F"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="50" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>